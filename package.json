{
  "name": "prisma-generic",
  "version": "0.0.1",
  "description": "A generic prisma image for running migrations",
  "main": "index.js",
  "scripts": {
    "docker:build": "docker build -t prisma-generic -f Dockerfile .",
    "docker:run": "docker run --name prisma-generic --rm -it prisma-generic",
    "test": "node --test test/*.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjsr/prisma-generic.git"
  },
  "keywords": [
    "Prisma",
    "node",
    "npm",
    "docker",
    "database"
  ],
  "author": "Tim Rowe <tim@tjsr.id.au>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tjsr/prisma-generic/issues"
  },
  "homepage": "https://github.com/tjsr/prisma-generic#readme",
  "devDependencies": {
    "@prisma/client": "6.15.0",
    "@prisma/engines": "6.15.0",
    "prisma": "6.15.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=12.2.1"
  },
  "allowScripts": {
    "prisma@6.15.0": true,
    "@prisma/client@6.15.0": true,
    "@prisma/engines@6.15.0": true
  }
}
